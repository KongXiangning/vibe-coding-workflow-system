{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SourceRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "item_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
            },
            "section": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "lines": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "uri"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "uri"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "text",
            "label"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TaskRef": {
      "type": "object",
      "properties": {
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "plan_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "step_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "task_id",
        "source"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "relation": {
          "type": "string",
          "enum": [
            "part_of",
            "supports",
            "addresses",
            "depends_on",
            "replaces",
            "derived_from",
            "discusses",
            "references"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "origin": {
          "type": "string",
          "enum": [
            "declared",
            "inferred"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "dismissed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "relation",
        "target",
        "origin",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "inferred"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "reason",
              "sources"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "dismissed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "TaskBinding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "role": {
          "type": "string",
          "enum": [
            "implementation",
            "repair",
            "verification",
            "exploration",
            "reference"
          ]
        },
        "coverage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origin": {
          "type": "string",
          "enum": [
            "declared",
            "inferred"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "dismissed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0
        },
        "plan_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "plan_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "work_item_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              }
            },
            "required": [
              "plan_id",
              "work_item_id"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task": {
                "$ref": "#/$defs/TaskRef"
              },
              "coverage": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              }
            },
            "required": [
              "task",
              "coverage",
              "sources"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "task",
        "role",
        "coverage",
        "origin",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "inferred"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "reason",
              "sources"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "dismissed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "WorkItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "coverage": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "target",
              "coverage"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "included",
            "deferred",
            "withdrawn"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "initial",
            "added",
            "unknown"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "order",
                  "prerequisite"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "item_id",
              "kind",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "title",
        "outcome",
        "scope",
        "targets",
        "state",
        "origin"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "manifest": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "detail": {
      "type": "string",
      "enum": [
        "summary",
        "items"
      ]
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
      },
      "minItems": 0
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_file_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "max_total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "resolve_sources": {
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "impact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
      },
      "minItems": 0
    },
    "discussion_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
      },
      "minItems": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "type": "string"
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
                },
                "metadata": {
                  "type": "object"
                },
                "body": {
                  "type": "string"
                },
                "remove_fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 0
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "append": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metadata": {
                  "type": "object"
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "metadata",
                "body"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "migrate": {
            "const": "v2"
          },
          "preimage_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "path",
          "expected_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text": {
      "type": "string"
    },
    "base64": {
      "type": "string"
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "expected_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "type": "string"
    }
  },
  "required": [],
  "additionalProperties": false
}
