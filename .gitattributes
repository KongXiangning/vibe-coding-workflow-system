# Normalize text files consistently across platforms.
* text=auto

# Keep repository source and generated docs on LF to avoid Windows CRLF drift.
*.md text eol=lf
*.tmpl text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Common binary assets.
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
