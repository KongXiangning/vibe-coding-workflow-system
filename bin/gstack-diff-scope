#!/usr/bin/env bun

import { spawnSync } from 'child_process';

const BASE = process.argv[2] ?? 'main';

function gitDiff(args: string[]): string {
  const result = spawnSync('git', args, {
    stdio: 'pipe',
    timeout: 5_000,
  });
  if (result.status !== 0) {
    return '';
  }
  return result.stdout.toString().trim();
}

function getChangedFiles(base: string): string[] {
  const primary = gitDiff(['diff', `${base}...HEAD`, '--name-only']);
  const fallback = primary || gitDiff(['diff', base, '--name-only']);
  return fallback
    .split(/\r?\n/)
    .map(file => file.trim().replace(/\\/g, '/'))
    .filter(Boolean);
}

function matchesAny(file: string, patterns: RegExp[]): boolean {
  return patterns.some(pattern => pattern.test(file));
}

const files = getChangedFiles(BASE);

const scope = {
  SCOPE_FRONTEND: false,
  SCOPE_BACKEND: false,
  SCOPE_PROMPTS: false,
  SCOPE_TESTS: false,
  SCOPE_DOCS: false,
  SCOPE_CONFIG: false,
  SCOPE_MIGRATIONS: false,
  SCOPE_API: false,
  SCOPE_AUTH: false,
};

const frontendPatterns = [
  /\.(css|scss|less|sass|pcss)$/i,
  /\.module\.(css|scss)$/i,
  /\.(tsx|jsx|vue|svelte|astro|erb|haml|slim|hbs|ejs|html)$/i,
  /(^|\/)(tailwind\.config|postcss\.config)\.[^/]+$/i,
  /(^|\/)app\/views\//,
  /(^|\/)components\//,
  /(^|\/)(styles|css)\//,
  /(^|\/)app\/assets\/stylesheets\//,
];

const promptPatterns = [
  /prompt_builder/i,
  /generation_service/i,
  /writer_service/i,
  /designer_service/i,
  /evaluator/i,
  /scorer/i,
  /classifier_service/i,
  /analyzer/i,
  /voice.*\.rb$/i,
  /writing.*\.rb$/i,
  /prompt.*\.rb$/i,
  /token.*\.rb$/i,
  /(^|\/)app\/services\/chat_tools\//,
  /(^|\/)app\/services\/x_thread_tools\//,
  /(^|\/)config\/system_prompts\//,
];

const testPatterns = [
  /\.(test|spec)\./i,
  /(_test|_spec)\./i,
  /(^|\/)(test|tests|spec|__tests__|cypress|e2e)\//,
];

const configPatterns = [
  /(^|\/)(package\.json|package-lock\.json|yarn\.lock|bun\.lockb)$/i,
  /(^|\/)(Gemfile|Gemfile\.lock)$/i,
  /\.(yml|yaml)$/i,
  /(^|\/)\.github\//,
  /(^|\/)(requirements\.txt|pyproject\.toml|go\.mod|Cargo\.toml|composer\.json)$/i,
];

const migrationPatterns = [
  /(^|\/)db\/migrate\//,
  /(^|\/).+\/migrations\//,
  /(^|\/)alembic\//,
  /(^|\/)prisma\/migrations\//,
];

const apiPatterns = [
  /controller/i,
  /route/i,
  /endpoint/i,
  /(^|\/)api\//,
  /\.(graphql|gql)$/i,
  /(^|\/)(openapi|swagger)\./i,
];

const authPatterns = [
  /auth/i,
  /session/i,
  /jwt/i,
  /oauth/i,
  /permission/i,
  /role/i,
];

const backendPatterns = [
  /\.(rb|py|go|rs|java|php|ex|exs|ts|js)$/i,
];

for (const file of files) {
  if (matchesAny(file, frontendPatterns)) scope.SCOPE_FRONTEND = true;
  if (matchesAny(file, promptPatterns)) scope.SCOPE_PROMPTS = true;
  if (matchesAny(file, testPatterns)) scope.SCOPE_TESTS = true;
  if (file.endsWith('.md')) scope.SCOPE_DOCS = true;
  if (matchesAny(file, configPatterns)) scope.SCOPE_CONFIG = true;
  if (matchesAny(file, migrationPatterns)) scope.SCOPE_MIGRATIONS = true;
  if (matchesAny(file, apiPatterns)) scope.SCOPE_API = true;
  if (matchesAny(file, authPatterns)) scope.SCOPE_AUTH = true;
  if (matchesAny(file, backendPatterns)) scope.SCOPE_BACKEND = true;
}

for (const [key, value] of Object.entries(scope)) {
  console.log(`${key}=${value}`);
}
