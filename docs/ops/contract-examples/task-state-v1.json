  "acceptance_cases": [
    {"id": "repeated-updates", "scenario": "同一 Task 和范围更新 100 次", "expected": "一份永久任务文件；零新增永久 event；无 100 次历史全文数组"},
    {"id": "different-environments", "scenario": "单元测试通过，真机失败", "expected": "两个独立结果；关闭后真机失败和未解决问题仍可见"},
    {"id": "new-execution", "scenario": "同一步骤产生新的实际代码实施", "expected": "旧 execution 的验证与审查不认证新 execution，未解决 finding 保留"},
    {"id": "revision-conflict", "scenario": "两个 Agent 基于同一旧 revision 更新", "expected": "旧写入明确冲突，不覆盖已保存结果，不重跑业务"},
    {"id": "stable-identity", "scenario": "调整显示名称或迁移旧格式", "expected": "真实 task_id 保持原值，绑定不按标题或编号猜测"},
    {"id": "scope-revision", "scenario": "采用新范围后，旧范围仍有正式绑定", "expected": "保留必要旧范围，旧结果不套用到新计划"},
    {"id": "cleanup-isolation", "scenario": "关闭 A，B 仍实施", "expected": "只清 A 的临时材料，B 的文件保持"},
    {"id": "late-capture", "scenario": "snapshot 尚未发布时任务关闭并开始清理", "expected": "迟到捕获不能重新留下 blob；未完成清理如实报告"},
    {"id": "resume-race", "scenario": "旧 cleanup 与任务 resume 竞争", "expected": "旧修订的清理不能删除新恢复工作产生的材料"},
    {"id": "source-stability", "scenario": "保存正式评估后仅执行 cleanup", "expected": "正式任务字节和摘要不变，报告来源不会因清理统计失效"},
    {"id": "offline-clone", "scenario": "只克隆 Git，临时 blob 不存在", "expected": "TraceLens 仍能展示任务身份、范围、结果和遗留问题"},
    {"id": "version-handoff", "scenario": "旧 TraceLens 收到 task-query/v2", "expected": "显示不支持或合法旧快照，不按完整历史 v1 解析"},
    {"id": "derived-return", "scenario": "派生任务关闭但 prerequisite 未满足", "expected": "不推导满足或自动 finish 父步骤；实际续接上下文保留"},
    {"id": "readonly", "scenario": "查询／刷新／打开来源", "expected": "不写任务、event、blob、时间戳或回执"},
    {"id": "migration-gap", "scenario": "旧来源缺失或关联歧义", "expected": "保留具体缺口，不伪造摘要、通过或完整迁移"}
  ]
}
